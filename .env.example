# Copy to .env. Never commit real values.
# AGENT_PROVIDER selects the agent's decision maker: mock (default, offline), simulated (offline, speaks the Claude tool protocol) or anthropic (live, needs both values below).
AGENT_PROVIDER=mock
# Both values are needed for npm run smoke:anthropic and npm run smoke:agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional server overrides
HOST=127.0.0.1
PORT=3000

# SQLite file for run history and approvals (default var/bullsnexa.sqlite; ignored by git).
# DATABASE_PATH=var/bullsnexa.sqlite

# Sign-in for /app and the API (the home page, /login and /health stay public).
# It is ON by default with the public demo login reviewer / demo-pass-1234 (see README).
# Override both on any deployment, or set AUTH=disabled to turn the sign-in off.
# AUTH_USERNAME=reviewer
# AUTH_PASSWORD=demo-pass-1234
# AUTH=enabled
# Optional: keeps sessions valid across restarts (random per process when unset).
# SESSION_SECRET=

# Requests per window for POST/DELETE under /api (0 disables the limiter).
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
# Set to "disabled" so DELETE /api/runs/:id answers 403 on a public demo.
# RUN_DELETION=enabled
# Set to "true" ONLY behind a reverse proxy you control (affects client IP and Secure cookies).
# TRUST_PROXY=false
