# Copy to .env. Never commit real values.
# AGENT_PROVIDER selects the agent's decision maker: mock (default, offline), simulated (offline, speaks the Claude tool protocol) or anthropic (live, needs both values below).
AGENT_PROVIDER=mock
# Both values are needed for npm run smoke:anthropic and npm run smoke:agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional server overrides
HOST=127.0.0.1
PORT=3000

# SQLite file for run history and approvals (default var/bullsnexa.sqlite; ignored by git).
# DATABASE_PATH=var/bullsnexa.sqlite
