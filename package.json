{
  "name": "bulls-nexa",
  "version": "0.1.0",
  "private": true,
  "description": "BullsNexa AI-powered campaign intelligence foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:anthropic": "node --env-file-if-exists=.env scripts/smoke-anthropic.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "fastify": "^5.6.2",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
